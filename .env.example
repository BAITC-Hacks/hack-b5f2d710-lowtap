# Скопируйте в .env (файл .env в .gitignore, ключ в репозиторий не попадает).
# Без ключа приложение работает полностью: для пресетов отдаётся сохранённый ответ агента (provider=cache),
# для остальных наборов — объяснение по правилам на тех же числах (provider=rules).

OPENAI_API_KEY=
# Основная модель агента и быстрая модель для коротких текстов.
# Реальный список доступных ключу моделей: GET https://api.openai.com/v1/models — подставьте id оттуда.
OPENAI_MODEL=
OPENAI_MODEL_FAST=
# Необязательно: OpenAI-совместимый сервер (Ollama, LM Studio) вместо api.openai.com
OPENAI_BASE_URL=

# auto | llm | rules
AI_PROVIDER=auto
# first (кэш → llm → rules; режим жюри без ключа) | fallback (llm → кэш → rules; демо) | 0 (llm → rules)
AI_CACHE=first
MAX_TOOL_ROUNDS=6
ANALYZE_CONCURRENCY=2
